# Copy this file to .env and fill in what you need:
#     cp .env.example .env
# .env is git-ignored - keys you put there never reach the repository.
# A variable already set in your shell takes precedence over this file.

# --- Claude (the four agents) -------------------------------------------------
# From https://console.anthropic.com -> API keys. Leave empty to use the
# rule-based fallback (free, offline). Also needs: .venv/bin/pip install anthropic
ANTHROPIC_API_KEY=

# Optional: limit which agents use Claude and cap the calls per run.
# EWS_AGENTS=news
# EWS_MAX_CALLS=200

# --- SEC EDGAR -----------------------------------------------------------------
# The SEC asks automated clients to identify themselves: organisation and email.
SEC_USER_AGENT="Tinubu EWS your.name@tinubu.com"

# Note: don't set EWS_DATASET here - it would switch every dashboard on this machine
# to that book. Pass it on the command line: EWS_DATASET=sbi python3 -m dashboard.server 8001
